{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Acme",
  "colors": {
    "primary": "#4F46E5",
    "light": "#818CF8",
    "dark": "#4338CA"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "family": "Inter"
  },
  "background": {
    "decoration": "gradient"
  },
  "icons": {
    "library": "lucide"
  },
  "navbar": {
    "links": [
      {
        "label": "Status",
        "href": "https://status.acme.dev"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get an API key",
      "href": "https://dashboard.acme.dev"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/chitalian/multirepo-test-docs",
      "x": "https://x.com/acme"
    }
  },
  "navigation": {
    "products": [
      {
        "product": "Guides",
        "icon": "book-open",
        "description": "Start here",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/fulfill-orders",
              "guides/how-these-docs-work"
            ]
          },
          {
            "group": "Updates",
            "pages": [
              "changelog"
            ]
          }
        ]
      },
      {
        "product": "API reference",
        "icon": "server",
        "description": "Endpoints, objects, and errors",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "api/introduction"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "api/reference/users",
              "api/reference/orders"
            ]
          }
        ]
      },
      {
        "product": "API operations",
        "icon": "wrench",
        "description": "Run and change the API service",
        "groups": [
          {
            "group": "Running the API",
            "pages": [
              "api-ops/overview",
              "api-ops/local-development",
              "api-ops/configuration"
            ]
          },
          {
            "group": "Contributing",
            "pages": [
              "api-ops/add-an-endpoint"
            ]
          },
          {
            "group": "Runbooks",
            "pages": [
              "api-ops/runbooks/auth-failures",
              "api-ops/runbooks/rotate-api-key"
            ]
          }
        ]
      },
      {
        "product": "Live sample",
        "icon": "sparkles",
        "description": "Doc set added live in the demo",
        "groups": [
          {
            "group": "Welcome",
            "pages": [
              "sample/sample"
            ]
          }
        ]
      },
      {
        "product": "SDK",
        "icon": "braces",
        "description": "Typed JavaScript client",
        "groups": [
          {
            "group": "JavaScript",
            "pages": [
              "sdk/install",
              "sdk/guides/usage"
            ]
          }
        ]
      }
    ]
  },
  "variables": {
    "apiVersion": "2026-10"
  },
  "redirects": [
    {
      "source": "/api/old-users",
      "destination": "/api/reference/users"
    }
  ]
}
